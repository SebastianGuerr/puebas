	measure 'D pregunta título' = VAR f = [Fecha mostrada] VAR dia = SWITCH ( WEEKDAY ( f, 2 ), 1, "LUNES", 2, "MARTES", 3, "MIÉRCOLES", 4, "JUEVES", 5, "VIERNES", 6, "SÁBADO", "DOMINGO" ) RETURN "¿MÁS QUE UN " & dia & " NORMAL?"
		displayFolder: Tablero
