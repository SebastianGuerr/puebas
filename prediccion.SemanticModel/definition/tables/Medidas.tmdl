	measure 'D pregunta respuesta' = VAR p = [D prob más] RETURN SWITCH ( TRUE (), ISBLANK ( p ), BLANK (), p >= 0.7, "Muy probable", p >= 0.55, "Probable", p > 0.45, "Igual de probable que no", p > 0.3, "Poco probable", "Improbable" )
		displayFolder: Tablero
