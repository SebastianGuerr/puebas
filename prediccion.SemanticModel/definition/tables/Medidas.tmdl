	measure 'D pregunta detalle' = VAR f = [Fecha mostrada] VAR dia = SWITCH ( WEEKDAY ( f, 2 ), 1, "lunes", 2, "martes", 3, "miércoles", 4, "jueves", 5, "viernes", 6, "sábado", "domingo" ) RETURN [D pregunta respuesta] & "  ·  un " & dia & " normal: " & FORMAT ( [Día habitual], "0" ) & IF ( [T Filtra aseguradora], "  ·  (todas las aseguradoras)", "" )
		displayFolder: Tablero
