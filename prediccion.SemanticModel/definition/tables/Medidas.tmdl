	measure 'D semana título' = "SEMANA DEL " & UPPER ( LOOKUPVALUE ( Calendario[Semana etiqueta], Calendario[Date], [Fecha mostrada] ) )
		displayFolder: Tablero
		lineageTag: 8a162fa2-29f8-4d54-a00b-4714220413c2

	/// Total de la semana del día elegido: rango del modelo (7 × media diaria q10-q90) para el total; aproximado para una aseguradora.
	measure 'D semana rango' =
			VAR l = [D semana lunes] VAR m = [Modelo mostrado]
			VAR a = CALCULATE ( SUM ( 'Pronóstico semana'[media_q10] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l ) * 7
			VAR b = CALCULATE ( SUM ( 'Pronóstico semana'[media_q90] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l ) * 7
			VAR c = IF ( [T Filtra aseguradora], CALCULATE ( SUM ( 'Pronóstico aseguradora'[q50] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico aseguradora'[modelo] = m, 'Pronóstico aseguradora'[fecha] >= l, 'Pronóstico aseguradora'[fecha] <= l + 6 ), CALCULATE ( SUM ( 'Pronóstico día'[q50] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico día'[modelo] = m, 'Pronóstico día'[fecha] >= l, 'Pronóstico día'[fecha] <= l + 6 ) )
			RETURN IF ( NOT [T Filtra aseguradora] && NOT ISBLANK ( a ), FORMAT ( a, "#,0" ) & " a " & FORMAT ( b, "#,0" ), IF ( NOT ISBLANK ( c ), "≈ " & FORMAT ( c, "#,0" ) ) )
		displayFolder: Tablero
		lineageTag: 095ffce5-04c5-43f5-9c57-df7fce611c0d

	measure 'D semana detalle' =
			VAR l = [D semana lunes] VAR m = [Modelo mostrado]
			VAR p = CALCULATE ( AVERAGE ( 'Pronóstico semana'[p_sobre_habitual] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l )
			VAR hab = CALCULATE ( SUM ( 'Pronóstico semana'[habitual] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l ) * 7
			RETURN IF ( [T Filtra aseguradora] || ISBLANK ( p ), "pacientes en la semana", "pacientes  ·  " & FORMAT ( p, "0%" ) & " de prob. de superar una semana normal (" & FORMAT ( hab, "#,0" ) & ")" )
		displayFolder: Tablero
		lineageTag: fbd89839-81e9-4bf3-9960-4632f8cac466

	measure 'D mes título' = VAR f = [Fecha mostrada] RETURN UPPER ( FORMAT ( f, "mmmm", "es-CO" ) ) & IF ( MONTH ( f ) = MONTH ( [Fecha hoy] ) && YEAR ( f ) = YEAR ( [Fecha hoy] ), " (LO QUE QUEDA)", "" )
		displayFolder: Tablero
		lineageTag: 1975fb1d-b1c2-40cb-9180-0de197c5a988

	/// Pacientes por día en el mes del día elegido: promedio de los rangos semanales del modelo (semanas que empiezan en el mes); aproximado para una aseguradora.
	measure 'D mes rango' =
			VAR f = [Fecha mostrada] VAR m = [Modelo mostrado] VAR a0 = DATE ( YEAR ( f ), MONTH ( f ), 1 ) VAR b0 = EOMONTH ( f, 0 )
			VAR a = CALCULATE ( AVERAGE ( 'Pronóstico semana'[media_q10] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] >= a0, 'Pronóstico semana'[lunes] <= b0 )
			VAR b = CALCULATE ( AVERAGE ( 'Pronóstico semana'[media_q90] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] >= a0, 'Pronóstico semana'[lunes] <= b0 )
			VAR c = CALCULATE ( AVERAGE ( 'Pronóstico aseguradora'[q50] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico aseguradora'[modelo] = m, 'Pronóstico aseguradora'[fecha] >= a0, 'Pronóstico aseguradora'[fecha] <= b0 ) * CALCULATE ( DISTINCTCOUNT ( 'Pronóstico aseguradora'[aseguradora] ), REMOVEFILTERS ( Calendario ) )
			RETURN IF ( NOT [T Filtra aseguradora] && NOT ISBLANK ( a ), FORMAT ( a, "0" ) & " a " & FORMAT ( b, "0" ), IF ( NOT ISBLANK ( c ), "≈ " & FORMAT ( c, "0" ) ) )
		displayFolder: Tablero
		lineageTag: 93f05a6a-73d9-419f-9df2-26f57edc20b3

	measure 'D mes detalle' =
			VAR f = [Fecha mostrada] VAR m = [Modelo mostrado] VAR h = [Fecha hoy] VAR a0 = MAX ( DATE ( YEAR ( f ), MONTH ( f ), 1 ), h ) VAR b0 = EOMONTH ( f, 0 )
			VAR tot = IF ( [T Filtra aseguradora], CALCULATE ( SUM ( 'Pronóstico aseguradora'[q50] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico aseguradora'[modelo] = m, 'Pronóstico aseguradora'[fecha] >= a0, 'Pronóstico aseguradora'[fecha] <= b0 ), CALCULATE ( SUM ( 'Pronóstico día'[q50] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico día'[modelo] = m, 'Pronóstico día'[fecha] >= a0, 'Pronóstico día'[fecha] <= b0 ) )
			RETURN "pacientes por día  ·  ≈ " & FORMAT ( tot, "#,0" ) & IF ( a0 > DATE ( YEAR ( f ), MONTH ( f ), 1 ), " en lo que queda del mes", " en el mes" ) & "  ·  aproximado"
		displayFolder: Tablero
		lineageTag: d70f58e3-6e1a-4a56-b237-396c41656a78

	/// Rango de pacientes del día (q10–q90); en la columna Total, el rango de la semana. * = festivo.
	measure 'T Calendario celda' =
			VAR h = [Fecha hoy] VAR m = [Modelo mostrado]
			RETURN IF ( NOT ISBLANK ( [T Calendario] ),
			  IF ( HASONEVALUE ( Calendario[Date] ),
			    VAR d = VALUES ( Calendario[Date] )
			    VAR fest = CALCULATE ( COUNTROWS ( 'Pronóstico día' ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico día'[modelo] = m, 'Pronóstico día'[fecha] = d, 'Pronóstico día'[festivo] = TRUE () ) > 0
			    RETURN FORMAT ( [V mínimo día], "0" ) & "–" & FORMAT ( [V máximo día], "0" ) & IF ( fest, "*", "" ),
			    VAR l = MIN ( Calendario[Semana del calendario] )
			    VAR a = CALCULATE ( SUM ( 'Pronóstico semana'[media_q10] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l ) * 7
			    VAR b = CALCULATE ( SUM ( 'Pronóstico semana'[media_q90] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l ) * 7
			    RETURN IF ( NOT [T Filtra aseguradora] && NOT ISBLANK ( a ) && l >= h, FORMAT ( a, "#,0" ) & "–" & FORMAT ( b, "#,0" ), "≈ " & FORMAT ( [T Calendario], "#,0" ) ) ) )
		displayFolder: Tablero
		lineageTag: bd225e0c-3241-4290-aabb-6315960d424c

	/// Rango de pacientes en la hora (q10–q90 del modelo; para aseguradoras sin rango por hora, intervalo de Poisson del 80 % alrededor de lo esperado).
	measure 'T Hora celda' =
			VAR v = [T Hora] VAR m = [Modelo mostrado] VAR f = [Fecha mostrada]
			RETURN IF ( NOT ISBLANK ( v ),
			  IF ( [T Filtra aseguradora],
			    VAR filas = CALCULATETABLE ( 'Aseguradora por hora', REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Aseguradora por hora'[modelo] = m, 'Aseguradora por hora'[fecha] = f )
			    VAR sin_rango = COUNTROWS ( FILTER ( filas, ISBLANK ( 'Aseguradora por hora'[q10] ) ) )
			    VAR l = SUMX ( filas, 'Aseguradora por hora'[esperado] )
			    VAR a = IF ( sin_rango = 0, SUMX ( filas, 'Aseguradora por hora'[q10] ), MINX ( FILTER ( GENERATESERIES ( 0, 80 ), POISSON.DIST ( [Value], l, TRUE ) >= 0.1 ), [Value] ) )
			    VAR b = IF ( sin_rango = 0, SUMX ( filas, 'Aseguradora por hora'[q90] ), MINX ( FILTER ( GENERATESERIES ( 0, 80 ), POISSON.DIST ( [Value], l, TRUE ) >= 0.9 ), [Value] ) )
			    RETURN FORMAT ( a, "0" ) & "–" & FORMAT ( b, "0" ),
			    VAR a = CALCULATE ( SUM ( 'Pronóstico hora'[q10] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico hora'[modelo] = m, 'Pronóstico hora'[fecha] = f )
			    VAR b = CALCULATE ( SUM ( 'Pronóstico hora'[q90] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico hora'[modelo] = m, 'Pronóstico hora'[fecha] = f )
			    RETURN FORMAT ( a, "0" ) & "–" & FORMAT ( b, "0" ) ) )
		displayFolder: Tablero
		lineageTag: 16dd54b0-0e44-4d3e-9622-069b4d9ee8e8

	/// Valor central por aseguradora del periodo elegido: la hora tocada, el día tocado, la semana tocada o, sin nada, hoy. Sirve para la barra.
	measure 'A pacientes' = VAR m = [Modelo mostrado] VAR f = [Fecha mostrada] RETURN IF ( ISFILTERED ( Hora ), CALCULATE ( SUM ( 'Aseguradora por hora'[esperado] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Aseguradora por hora'[modelo] = m, 'Aseguradora por hora'[fecha] = f ), [T Aseguradoras] )
		formatString: 0
		displayFolder: Tablero
		lineageTag: 8f9e1bd5-c321-47de-97da-5f8c81895a1d

	/// Rango por aseguradora del periodo elegido.
	measure 'A rango' =
			VAR m = [Modelo mostrado] VAR f = [Fecha mostrada]
			RETURN IF ( ISBLANK ( [A pacientes] ), BLANK (),
			  IF ( ISFILTERED ( Hora ),
			    VAR filas = CALCULATETABLE ( 'Aseguradora por hora', REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Aseguradora por hora'[modelo] = m, 'Aseguradora por hora'[fecha] = f )
			    VAR sin_rango = COUNTROWS ( FILTER ( filas, ISBLANK ( 'Aseguradora por hora'[q10] ) ) )
			    VAR l = SUMX ( filas, 'Aseguradora por hora'[esperado] )
			    VAR a = IF ( sin_rango = 0, SUMX ( filas, 'Aseguradora por hora'[q10] ), MINX ( FILTER ( GENERATESERIES ( 0, 80 ), POISSON.DIST ( [Value], l, TRUE ) >= 0.1 ), [Value] ) )
			    VAR b = IF ( sin_rango = 0, SUMX ( filas, 'Aseguradora por hora'[q90] ), MINX ( FILTER ( GENERATESERIES ( 0, 80 ), POISSON.DIST ( [Value], l, TRUE ) >= 0.9 ), [Value] ) )
			    RETURN FORMAT ( a, "0" ) & " a " & FORMAT ( b, "0" ),
			    IF ( HASONEVALUE ( Calendario[Date] ) || NOT ISFILTERED ( Calendario ),
			      FORMAT ( [Aseguradora mínimo], "0" ) & " a " & FORMAT ( [Aseguradora máximo], "0" ),
			      "≈ " & FORMAT ( [A pacientes], "#,0" ) ) ) )
		displayFolder: Tablero
		lineageTag: 5bd8d225-4d92-472a-9b7a-187bde21540f

	/// Con qué frecuencia ha acertado ese rango: por día, medido en el historial de cada aseguradora; por hora, en las horas ya verificadas (del total).
	measure 'A acierta' = IF ( ISBLANK ( [A pacientes] ), BLANK (), IF ( ISFILTERED ( Hora ), [P acierto hora], IF ( HASONEVALUE ( Calendario[Date] ) || NOT ISFILTERED ( Calendario ), [P acierto aseguradora] ) ) )
		formatString: 0%
		displayFolder: Tablero
		lineageTag: 810a0dce-e42f-4c88-81f9-95e04a88bebb

	measure 'T Nota rangos' = "Las cifras son rangos, no cantidades exactas: entre cuántos y cuántos pacientes es probable que lleguen.  «Acierta " & FORMAT ( [P acierto día], "0%" ) & "» quiere decir que, de cada 100 días ya pasados, en " & FORMAT ( 100 * [P acierto día], "0" ) & " el número real quedó dentro del rango."
		displayFolder: Tablero
		lineageTag: dc916129-a421-4d28-b98a-a1fd1bc9736f

	measure 'D rango corto' = IF ( NOT ISBLANK ( [V día] ), FORMAT ( [V mínimo día], "0" ) & " – " & FORMAT ( [V máximo día], "0" ) )
		displayFolder: Tablero
		lineageTag: 41a144bb-e75d-470a-9f31-5e4edf4667b1

	/// Probabilidad medida de que el real quede en el rango del día (total o aseguradora elegida).
	measure 'D píldora' = FORMAT ( 100 * IF ( [T Filtra aseguradora], [P acierto aseguradora], [P acierto día] ), "0" ) & " % de probabilidad"
		displayFolder: Tablero
		lineageTag: a2b2eea9-fcc9-4933-8e68-82d609a6e76b

	measure 'H píldora' = FORMAT ( 100 * [P acierto hora], "0" ) & " % de probabilidad"
		displayFolder: Tablero
		lineageTag: 4a07ae30-9bed-4756-9ce8-3891053040c8

	/// Largo de la barra = valor más probable; la etiqueta (formato dinámico) muestra el rango y su probabilidad.
	measure 'A barra' = [A pacientes]
		displayFolder: Tablero
		lineageTag: 4b1d252d-da33-40e8-bef1-83398e9fcb00

		formatStringDefinition = VAR r = SUBSTITUTE ( [A rango], " a ", "–" ) VAR p = [A acierta] RETURN """" & r & IF ( NOT ISBLANK ( p ), "   ·  " & FORMAT ( 100 * p, "0" ) & " %", "" ) & """"

	/// Pacientes por día de cada semana (eje: Calendario[Semana del calendario]). Total: media del modelo; aseguradora: promedio de sus valores centrales. Etiqueta: el rango (q10–q90 de la media diaria) o «≈».
	measure 'S por día' =
			VAR l = MIN ( Calendario[Semana del calendario] ) VAR m = [Modelo mostrado] VAR h = [Fecha hoy]
			RETURN IF ( HASONEVALUE ( Calendario[Semana del calendario] ) && l >= h - 6,
			  IF ( [T Filtra aseguradora],
			    DIVIDE ( CALCULATE ( SUM ( 'Pronóstico aseguradora'[q50] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico aseguradora'[modelo] = m, 'Pronóstico aseguradora'[fecha] >= l, 'Pronóstico aseguradora'[fecha] <= l + 6 ), CALCULATE ( DISTINCTCOUNT ( 'Pronóstico aseguradora'[fecha] ), REMOVEFILTERS ( Modelo ), REMOVEFILTERS ( Calendario ), 'Pronóstico aseguradora'[modelo] = m, 'Pronóstico aseguradora'[fecha] >= l, 'Pronóstico aseguradora'[fecha] <= l + 6 ) ),
			    CALCULATE ( SUM ( 'Pronóstico semana'[media_q50] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l ) ) )
		displayFolder: Tablero
		lineageTag: 5c053568-153b-405f-b5db-74254916047c

		formatStringDefinition =
				VAR l = MIN ( Calendario[Semana del calendario] ) VAR m = [Modelo mostrado]
				VAR a = CALCULATE ( SUM ( 'Pronóstico semana'[media_q10] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l )
				VAR b = CALCULATE ( SUM ( 'Pronóstico semana'[media_q90] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l )
				RETURN IF ( [T Filtra aseguradora] || ISBLANK ( a ), """≈ ""0", """" & FORMAT ( a, "0" ) & "–" & FORMAT ( b, "0" ) & """" )

	/// Rojo intenso = semana probablemente por encima de lo normal; rosado = no. Azul si hay aseguradora elegida.
	measure 'S color' =
			VAR l = MIN ( Calendario[Semana del calendario] ) VAR m = [Modelo mostrado]
			VAR p = CALCULATE ( AVERAGE ( 'Pronóstico semana'[p_sobre_habitual] ), REMOVEFILTERS ( Modelo ), 'Pronóstico semana'[modelo] = m, 'Pronóstico semana'[lunes] = l )
			RETURN IF ( [T Filtra aseguradora], "#6da7ec", SWITCH ( TRUE (), ISBLANK ( p ), "#f8c4c2", p >= 0.7, "#a82a2a", p >= 0.55, "#e34948", "#f8c4c2" ) )
		displayFolder: Tablero
		lineageTag: 2f037f99-431e-4f5f-a3e9-da85d00c9a6a

	measure 'S título' = "PRÓXIMAS SEMANAS  ·  PACIENTES POR DÍA" & IF ( [T Filtra aseguradora], "  ·  " & UPPER ( [T Grupo elegido] ), "" )
		displayFolder: Tablero
		lineageTag: 02b4f3a9-a924-4a26-b347-086cd493fb57

	column oculta
		isHidden
		lineageTag: 4cb1ae31-fd3b-4e7c-9828-078aca5940a4
		isNameInferred
		sourceColumn: [oculta]

	partition Medidas = calculated
		mode: import
		source = ROW ( "oculta", BLANK () )

